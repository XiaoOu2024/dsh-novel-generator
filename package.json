{
  "name": "dsh-novel-generator",
  "version": "0.1.11",
  "type": "module",
  "description": "Novel studio for DeepSeek Harness: a draggable story timeline, world snapshots, chapter outlines, and chapters written by the work's own agent.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "writing",
    "timeline",
    "worldbuilding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaoOu2024/dsh-novel-generator.git"
  },
  "homepage": "https://github.com/XiaoOu2024/dsh-novel-generator#readme",
  "bugs": {
    "url": "https://github.com/XiaoOu2024/dsh-novel-generator/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
